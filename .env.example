# Local origin for local builds; confirmed canonical origin for eventual production.
# Vercel previews automatically use VERCEL_URL instead of this value.
NEXT_PUBLIC_SITE_URL=
# Separate launch gates. Also require confirmed site.ts decisions and VERCEL_ENV=production.
SITE_INDEXING_ENABLED=false
SITE_ANALYTICS_ENABLED=false
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
# Enable only after the inbox, sending domain and delivery tests are approved.
ENQUIRY_DELIVERY_ENABLED=false
NEXT_PUBLIC_MAPS_KEY=
# Optional local/preview override. Production never renders the temporary images.
REVIEW_IMAGES_ENABLED=true
